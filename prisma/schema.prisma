// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model language {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  code         String        @unique
  icon         String
  languageLvls languageLvl[]
  courses      course[]

  @@map("languages")
}

model languageLvl {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  language   language @relation(fields: [languageId], references: [id])
  languageId Int
  courses    course[]

  @@map("language_lvls")
}

model category {
  id      Int      @id @default(autoincrement())
  name    String   @unique
  courses course[]

  @@map("categories")
}

model course {
  id          Int     @id @default(autoincrement())
  title       String
  cid         String  @unique
  description String?
  icon        String?

  language      language    @relation(fields: [languageId], references: [id])
  languageId    Int
  languageLvl   languageLvl @relation(fields: [languageLvlId], references: [id])
  languageLvlId Int
  category      category?   @relation(fields: [categoryId], references: [id])
  categoryId    Int?
  lessons       lesson[]

  @@map("courses")
}

model lesson {
  id          Int     @id @default(autoincrement())
  cid         String  @unique
  title       String
  description String?
  icon        String?

  course   course  @relation(fields: [courseId], references: [id])
  courseId Int
  blocks   block[]

  @@map("lessons")
}

model block {
  id       Int       @id @default(autoincrement())
  lesson   lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId Int
  order    Int
  type     BlockType
  title    String?
  content  Json

  @@unique([lessonId, order])
  @@map("blocks")
}

enum BlockType {
  MARKDOWN
  ONE_TRUE_CHOICE
  FILL_IN_BLANK
  MANUAL_ANSWER
  BUILD_SENTENCE
  TRANSLATION
  MATCHING
  DIALOGUE
  REPHRASING
  ERROR_CORRECTION
}
