// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model language {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  code         String        @unique
  icon         String
  languageLvls languageLvl[]
  courses      course[]

  @@map("languages")
}

model languageLvl {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  language   language @relation(fields: [languageId], references: [id])
  languageId Int
  courses    course[]

  @@map("language_lvls")
}

model category {
  id      Int      @id @default(autoincrement())
  name    String   @unique
  courses course[]

  @@map("categories")
}

model course {
  id          Int     @id @default(autoincrement())
  title       String
  description String?
  icon        String?

  language      language    @relation(fields: [languageId], references: [id])
  languageId    Int
  languageLvl   languageLvl @relation(fields: [languageLvlId], references: [id])
  languageLvlId Int
  category      category?   @relation(fields: [categoryId], references: [id])
  categoryId    Int?
  lessons       lesson[]

  @@map("courses")
}

model lesson {
  id          Int     @id @default(autoincrement())
  title       String
  description String?
  icon        String?

  course      course     @relation(fields: [courseId], references: [id])
  courseId    Int
  blokInfos   blokInfo[]
  blokQuizzes blokQuiz[]

  @@map("lessons")
}

model blokInfo {
  id       Int     @id @default(autoincrement())
  number   Int
  title    String
  text     String?
  lesson   lesson  @relation(fields: [lessonId], references: [id])
  lessonId Int

  @@map("blokes_info")
}

model blokQuiz {
  id                   Int                   @id @default(autoincrement())
  number               Int
  title                String
  text                 String?
  lesson               lesson                @relation(fields: [lessonId], references: [id])
  lessonId             Int
  quizOneTrueChoises   quizOneTrueChoise[]
  quizFillInBlanks     quizFillInBlank[]
  quizManualAnswers    quizManualAnswer[]
  quizBuildSentences   quizBuildSentence[]
  quizTranslations     quizTranslation[]
  quizMatchings        quizMatching[]
  quizDialogues        quizDialogue[]
  quizRephrasings      quizRephrasing[]
  quizErrorCorrections quizErrorCorrection[]

  @@map("blokes_quizzes")
}

model quizOneTrueChoise {
  id            Int      @id @default(autoincrement())
  number        Int
  order         Int
  title         String
  text          String?
  options       String[]
  correctAnswer String
  blockQuiz     blokQuiz @relation(fields: [blockQuizId], references: [id])
  blockQuizId   Int

  @@map("quizzes_one_true_choice")
}

model quizFillInBlank {
  id            Int      @id @default(autoincrement())
  number        Int
  order         Int
  title         String
  text          String
  correctAnswer String
  blockQuiz     blokQuiz @relation(fields: [blockQuizId], references: [id])
  blockQuizId   Int

  @@map("quizzes_fill_in_blank")
}

model quizManualAnswer {
  id            Int      @id @default(autoincrement())
  number        Int
  order         Int
  title         String
  text          String
  correctAnswer String
  blockQuiz     blokQuiz @relation(fields: [blockQuizId], references: [id])
  blockQuizId   Int

  @@map("quizzes_manual_answer")
}

model quizBuildSentence {
  id           Int      @id @default(autoincrement())
  number       Int
  order        Int
  title        String
  words        String[]
  correctOrder Int[]
  blockQuiz    blokQuiz @relation(fields: [blockQuizId], references: [id])
  blockQuizId  Int

  @@map("quizzes_build_sentence")
}

model quizTranslation {
  id            Int      @id @default(autoincrement())
  number        Int
  order         Int
  title         String
  text          String
  translateTo   String
  correctAnswer String
  blockQuiz     blokQuiz @relation(fields: [blockQuizId], references: [id])
  blockQuizId   Int

  @@map("quizzes_translation")
}

model quizMatching {
  id          Int      @id @default(autoincrement())
  number      Int
  order       Int
  title       String
  pairs       Json
  blockQuiz   blokQuiz @relation(fields: [blockQuizId], references: [id])
  blockQuizId Int

  @@map("quizzes_matching")
}

model quizDialogue {
  id          Int                    @id @default(autoincrement())
  number      Int
  order       Int
  title       String
  dialogue    Json
  questions   quizDialogueQuestion[]
  blockQuiz   blokQuiz               @relation(fields: [blockQuizId], references: [id])
  blockQuizId Int

  @@map("quizzes_dialogue")
}

model quizDialogueQuestion {
  id             Int          @id @default(autoincrement())
  number         Int
  order          Int
  question       String
  correctAnswer  String
  quizDialogue   quizDialogue @relation(fields: [quizDialogueId], references: [id])
  quizDialogueId Int

  @@map("quizzes_dialogue_questions")
}

model quizRephrasing {
  id            Int      @id @default(autoincrement())
  number        Int
  order         Int
  title         String
  text          String
  correctAnswer String
  blockQuiz     blokQuiz @relation(fields: [blockQuizId], references: [id])
  blockQuizId   Int

  @@map("quizzes_rephrasing")
}

model quizErrorCorrection {
  id            Int      @id @default(autoincrement())
  number        Int
  order         Int
  title         String
  text          String
  errorText     String
  correctAnswer String
  blockQuiz     blokQuiz @relation(fields: [blockQuizId], references: [id])
  blockQuizId   Int

  @@map("quizzes_error_correction")
}
