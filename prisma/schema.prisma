// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model language {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  code         String        @unique
  languageLvls  languageLvl[]
  courses       course[]     @relation("CourseLanguage")
  nativeCourses course[]     @relation("CourseNativeLanguage")

  @@map("languages")
}

model languageLvl {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  language   language @relation(fields: [languageId], references: [id])
  languageId Int
  courses    course[]

  @@map("language_lvls")
}

model category {
  id      Int      @id @default(autoincrement())
  name    String   @unique
  courses course[]

  @@map("categories")
}

model course {
  id          Int     @id @default(autoincrement())
  title       String
  cid         String  @unique
  description String?
  icon        String?
  isFree      Boolean @default(false)

  language         language    @relation("CourseLanguage", fields: [languageId], references: [id])
  languageId       Int
  nativeLanguage   language?   @relation("CourseNativeLanguage", fields: [nativeLanguageId], references: [id])
  nativeLanguageId Int?
  languageLvl      languageLvl @relation(fields: [languageLvlId], references: [id])
  languageLvlId    Int
  category         category?   @relation(fields: [categoryId], references: [id])
  categoryId       Int?
  lessons       lesson[]
  entitlements  entitlement[]

  @@map("courses")
}

// Local read-model of course ownership. Populated from billing's
// `course.purchased` events over RabbitMQ so access checks stay local (no
// synchronous cross-service calls on the content-delivery hot path).
model entitlement {
  id        Int      @id @default(autoincrement())
  userId    String
  course    course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId  Int
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
  @@map("entitlements")
}

model lesson {
  id          Int     @id @default(autoincrement())
  cid         String  @unique
  title       String
  description String?
  order       Int     @default(0)

  course   course  @relation(fields: [courseId], references: [id])
  courseId Int
  blocks   block[]
  progress lessonProgress[]

  @@unique([courseId, order])
  @@map("lessons")
}

// Local read-model of per-user lesson completion. Keyed by `userId` (a plain
// string from the gateway's X-User-Id; there is no local user table). `courseId`
// is denormalized so per-course progress counts run on a single index without
// joining through `lesson`.
model lessonProgress {
  id          Int      @id @default(autoincrement())
  userId      String
  lesson      lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId    Int
  courseId    Int
  completedAt DateTime @default(now())

  @@unique([userId, lessonId])
  @@index([userId, courseId])
  @@map("lesson_progress")
}

model block {
  id       Int       @id @default(autoincrement())
  lesson   lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId Int
  order    Int
  type     BlockType
  title    String?
  content  Json

  @@unique([lessonId, order])
  @@map("blocks")
}

enum BlockType {
  MARKDOWN
  ONE_TRUE_CHOICE
  FILL_IN_BLANK
  MANUAL_ANSWER
  BUILD_SENTENCE
  TRANSLATION
  MATCHING
  DIALOGUE
  REPHRASING
  ERROR_CORRECTION
}
